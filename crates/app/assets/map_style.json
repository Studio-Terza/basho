    { "id": "land-farm", "type": "fill", "source": "base", "source-layer": "land", "filter": ["==", ["get", "class"], "farm"], "paint": { "fill-color": "#cfcfcf" } },
    { "id": "land-forest", "metadata": { "key": "forest" }, "type": "fill", "source": "base", "source-layer": "land", "filter": ["==", ["get", "class"], "forest"], "paint": { "fill-color": "#b2b2b2" } },
    { "id": "land-green", "type": "fill", "source": "base", "source-layer": "land", "filter": ["==", ["get", "class"], "green"], "paint": { "fill-color": "#bababa" } },
