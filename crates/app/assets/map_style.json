    { "id": "water-line", "metadata": { "key": "water" }, "type": "line", "source": "base", "source-layer": "water_line", "paint": { "line-color": "#8c8c8c", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 15, 1.6] } },
    { "id": "coast", "metadata": { "key": "water" }, "type": "line", "source": "base", "source-layer": "coast", "paint": { "line-color": "#5a5a5a", "line-width": 1.3 } },
    { "id": "building", "metadata": { "key": "building" }, "type": "fill", "source": "base", "source-layer": "building", "minzoom": 14, "paint": { "fill-color": "#b4b4b4", "fill-outline-color": "#8a8a8a" } },
    { "id": "terrain", "type": "line", "source": "base", "source-layer": "terrain", "paint": { "line-color": "#6e6e6e", "line-width": 0.8 } },
