    { "id": "road-unpaved", "metadata": { "key": "road_unpaved" }, "type": "line", "source": "base", "source-layer": "road", "filter": ["all", ["==", ["get", "surface"], "unpaved"], ["!=", ["get", "structure"], "tunnel"]], "paint": { "line-color": "#1c1c1c", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1.1, 17, 2.2], "line-dasharray": [3, 2] } },
    { "id": "road-bridge", "metadata": { "key": "bridge" }, "type": "line", "source": "base", "source-layer": "road", "filter": ["==", ["get", "structure"], "bridge"], "minzoom": 13, "layout": { "line-cap": "butt" }, "paint": { "line-color": "#000000", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 4, 17, 11] } },
    { "id": "road-bridge-deck", "type": "line", "source": "base", "source-layer": "road", "filter": ["==", ["get", "structure"], "bridge"], "minzoom": 13, "layout": { "line-cap": "butt" }, "paint": { "line-color": "#f2f2f2", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 2.6, 17, 8.4] } },
    { "id": "road-lane", "metadata": { "key": "road_lane" }, "type": "line", "source": "base", "source-layer": "road", "filter": ["all", ["==", ["get", "surface"], "paved"], ["in", ["get", "class"], ["literal", ["lane", "track", "trail"]]], ["!=", ["get", "structure"], "tunnel"]], "paint": { "line-color": "#2a2a2a", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.7, 17, 1.6] } },
    { "id": "road-street", "metadata": { "key": "road_street" }, "type": "line", "source": "base", "source-layer": "road", "filter": ["all", ["==", ["get", "surface"], "paved"], ["==", ["get", "class"], "street"], ["!=", ["get", "structure"], "tunnel"]], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#161616", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.7, 14, 1.3, 17, 2.6] } },
