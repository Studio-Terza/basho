    { "id": "road-major-middle", "type": "line", "source": "base", "source-layer": "road", "filter": ["all", ["==", ["get", "class"], "major"], ["!=", ["get", "surface"], "unpaved"], ["!=", ["get", "structure"], "tunnel"]], "minzoom": 10, "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#f7f7f7", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 12, 1.6, 14, 2.8, 17, 6] } },
