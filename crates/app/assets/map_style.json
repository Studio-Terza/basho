{
  "version": 8,
  "name": "basho-greyscale",
  "sources": {
    "base": {
      "type": "vector",
      "tiles": ["basho://tiles/{z}/{x}/{y}"],
      "minzoom": 7,
      "maxzoom": 14
    },
    "route": { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "marks": { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } },
    "walker": { "type": "geojson", "data": { "type": "FeatureCollection", "features": [] } }
  },
  "layers": [
